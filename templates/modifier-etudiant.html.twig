<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Modifier étudiant - AlloStage</title>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/modifier-etudiant.css">
</head>

<body>

<div class="page">

    <div class="carte">

        <h1>✏️ Modifier l'étudiant</h1>
        <p class="subtitle">Modifiez les informations de l'étudiant</p>

        <form method="POST" class="formulaire">

            <div class="groupe">
                <label>Nom</label>
                <input type="text" name="nom" value="{{ etudiant.nom }}" required>
            </div>

            <div class="groupe">
                <label>Prénom</label>
                <input type="text" name="prenom" value="{{ etudiant.prenom }}" required>
            </div>

            <div class="groupe">
                <label>Email</label>
                <input type="email" name="email" value="{{ etudiant.email }}" required>
            </div>

            {% if session.user is defined and session.user.role == 'admin' %}
                <div class="groupe">
                    <label>Pilote rattaché</label>
                    <select name="id_pilote">
                        <option value="">— Aucun —</option>
                        {% for p in pilotes ?? [] %}
                            <option value="{{ p.id_user }}" {{ etudiant.id_pilote == p.id_user ? 'selected' : '' }}>
                                {{ p.prenom }} {{ p.nom }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
            {% endif %}

            <div class="actions">
                <a href="index.php?page=gestion-etudiants" class="btn-annuler">
                    Annuler
                </a>

                <button type="submit" class="btn-valider">
                    💾 Enregistrer
                </button>
            </div>

        </form>

    </div>

</div>

</body>
</html>