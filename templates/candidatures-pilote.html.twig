<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Candidatures de mes étudiants - AlloStage</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/mes-candidatures.css">
</head>

<body>

<div id="menu-overlay" class="menu-overlay"></div>

<div id="menu-burger" class="menu-burger">
    <button id="close-menu" class="close-btn">✕</button>
    <div class="menu-content">
        <a href="index.php">🏠 Accueil</a>
        <a href="index.php?page=offres">💼 Offres de stages</a>
        <a href="index.php?page=entreprises">🏢 Entreprises</a>
        <a href="index.php?page=statistiques">📊 Statistiques</a>
        <a href="index.php?page=gestion-etudiants">🎓 Gestion des étudiants</a>
        <a href="index.php?page=gestion-entreprises">🏢 Gestion des entreprises</a>
        <a href="index.php?page=gestion-offres">💼 Gestion des offres</a>
        <a href="index.php?page=candidatures-pilote">📁 Candidatures</a>
    </div>
    <a href="index.php?page=logout" class="btn-logout">🔴 Déconnexion</a>
</div>

<header class="entete">
    <div class="logo">
        <a href="index.php">
            <img src="/images/allostage.png" alt="Accueil AlloStage" class="logo-img">
        </a>
    </div>

    <nav class="navigation">
        <ul>
            <li><a href="index.php">Accueil</a></li>
            <li><a href="index.php?page=offres">Offres de stages</a></li>
            <li><a href="index.php?page=entreprises">Entreprises</a></li>
            <li><a href="index.php?page=statistiques">Statistiques</a></li>
            <li><a href="index.php?page=candidatures-pilote" class="actif">Candidatures</a></li>
        </ul>
    </nav>

    <div class="actions-entete">
        {% if session.user is defined %}
            <button id="open-menu" class="btn-principal">
                Espace {{ session.user.role_label ?? session.user.role|capitalize }} ▾
            </button>
        {% else %}
            <a href="index.php?page=connexion" class="btn-connexion">Se connecter</a>
        {% endif %}
    </div>
</header>

<main class="contenu fond-gris">

    <section class="en-tete-recherche">
        <h1>📁 Candidatures de mes étudiants</h1>
        <p>Liste des offres auxquelles vos étudiants ont postulé
           ({{ total }} candidature{{ total > 1 ? 's' : '' }}).</p>
    </section>

    {% if candidatures is empty %}
        <section class="conteneur-liste">
            <div class="empty-box">
                <p>Aucun de vos étudiants n'a encore postulé à une offre.</p>
            </div>
        </section>
    {% else %}

        <section class="filtres-candidatures">
            <div class="filtre-group">
                <label for="filtre-etudiant">👤 Étudiant :</label>
                <select id="filtre-etudiant">
                    <option value="">— Tous —</option>
                    {% for e in etudiants %}
                        <option value="{{ e.id }}">{{ e.nom }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="filtre-group">
                <label for="filtre-recherche">🔍 Rechercher :</label>
                <input type="text" id="filtre-recherche" placeholder="Titre, entreprise...">
            </div>
        </section>

        <section class="conteneur-liste">
            <div class="list" id="liste-candidatures">
                {% for c in candidatures %}
                    <div class="card carte-cand"
                         data-etudiant="{{ c.etudiant_id }}"
                         data-search="{{ (c.titre ~ ' ' ~ c.nom_entreprise ~ ' ' ~ c.etudiant_prenom ~ ' ' ~ c.etudiant_nom)|lower }}">

                        <div class="left">
                            <div class="ligne-etudiant">
                                <span class="avatar-mini">{{ (c.etudiant_prenom|slice(0,1) ~ c.etudiant_nom|slice(0,1))|upper }}</span>
                                <span>
                                    <strong>{{ c.etudiant_prenom }} {{ c.etudiant_nom }}</strong>
                                    <span class="mail">{{ c.etudiant_email }}</span>
                                </span>
                            </div>

                            <h3 class="titre-offre">{{ c.titre }}</h3>
                            <p class="entreprise-offre">
                                <strong>{{ c.nom_entreprise }}</strong>{% if c.ville %} • {{ c.ville }}{% endif %}
                            </p>
                            <p class="tags-mini">
                                {% if c.duree_stage %}📅 {{ c.duree_stage }} sem.{% endif %}
                                {% if c.competence %} • 🛠 {{ c.competence }}{% endif %}
                            </p>
                            <p class="date">📅 Envoyée le {{ c.date_envoi|date("d/m/Y à H:i") }}</p>
                        </div>

                        <div class="right">
                            {% if c.cv %}
                                <a href="/uploads/cv/{{ c.cv }}" target="_blank" class="btn">📄 CV</a>
                            {% else %}
                                <span class="btn btn-disabled" title="Aucun CV joint">CV ✕</span>
                            {% endif %}

                            {% if c.lm %}
                                <a href="/uploads/lm/{{ c.lm }}" target="_blank" class="btn btn-lettre">✉️ Lettre PDF</a>
                            {% elseif c.lm_texte %}
                                <button type="button" class="btn btn-lettre"
                                        onclick="ouvrirLettre({{ c.id_candidature }})">✉️ Voir lettre</button>
                                <template id="lettre-{{ c.id_candidature }}">{{ c.lm_texte }}</template>
                            {% else %}
                                <span class="btn btn-disabled" title="Pas de lettre">Lettre ✕</span>
                            {% endif %}

                            <a href="index.php?page=candidature-detail&id={{ c.id_candidature }}"
                               class="btn-lien">Détails →</a>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <p id="aucun-resultat" class="empty-filtre" style="display:none;">
                Aucune candidature ne correspond à votre recherche.
            </p>
        </section>
    {% endif %}
</main>

<!-- Modal lettre texte -->
<div id="modal-lettre" class="modal-bg" onclick="if(event.target===this)fermerLettre()">
    <div class="modal-box">
        <button class="modal-close" onclick="fermerLettre()">✕</button>
        <h2>✉️ Lettre de motivation</h2>
        <div id="modal-lettre-contenu" class="modal-contenu"></div>
    </div>
</div>

<footer class="pied-de-page">
    <p>&copy; 2026 AlloStage. Tous droits réservés.</p>
    <p class="liens-footer">
        <a href="index.php?page=mentions">Mentions légales</a>
    </p>
</footer>

<script>
const openBtn  = document.getElementById('open-menu');
const closeBtn = document.getElementById('close-menu');
const menu     = document.getElementById('menu-burger');
const overlay  = document.getElementById('menu-overlay');

function openMenu()  { menu.classList.add('active');    overlay.classList.add('active'); }
function closeMenu() { menu.classList.remove('active'); overlay.classList.remove('active'); }

if (openBtn)  openBtn.addEventListener('click', openMenu);
if (closeBtn) closeBtn.addEventListener('click', closeMenu);
if (overlay)  overlay.addEventListener('click', closeMenu);

// Filtre étudiant + recherche
const selEt   = document.getElementById('filtre-etudiant');
const inputQ  = document.getElementById('filtre-recherche');
const cartes  = document.querySelectorAll('.carte-cand');
const aucun   = document.getElementById('aucun-resultat');

function appliquerFiltres() {
    const eid = selEt ? selEt.value : '';
    const q   = inputQ ? inputQ.value.trim().toLowerCase() : '';
    let visibles = 0;
    cartes.forEach(c => {
        const okE = !eid || c.dataset.etudiant === eid;
        const okQ = !q   || c.dataset.search.includes(q);
        const show = okE && okQ;
        c.style.display = show ? '' : 'none';
        if (show) visibles++;
    });
    if (aucun) aucun.style.display = visibles === 0 ? 'block' : 'none';
}

if (selEt)  selEt.addEventListener('change', appliquerFiltres);
if (inputQ) inputQ.addEventListener('input',  appliquerFiltres);

// Modal lettre
const modalLettre  = document.getElementById('modal-lettre');
const modalContenu = document.getElementById('modal-lettre-contenu');

function ouvrirLettre(id) {
    const tpl = document.getElementById('lettre-' + id);
    if (!tpl) return;
    modalContenu.textContent = tpl.innerHTML.trim();
    modalLettre.classList.add('active');
}
function fermerLettre() {
    modalLettre.classList.remove('active');
}
document.addEventListener('keydown', e => { if (e.key === 'Escape') fermerLettre(); });
</script>

</body>
</html>
