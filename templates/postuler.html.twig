<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Postuler - {{ offre.titre }}</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/postuler.css">
</head>

<body>

<div id="menu-overlay" class="menu-overlay"></div>

<div id="menu-burger" class="menu-burger">
    <button id="close-menu" class="close-btn">✕</button>
    <div class="menu-content">
        <a href="index.php">🏠 Accueil</a>
        <a href="index.php?page=offres">💼 Offres de stages</a>
        <a href="index.php?page=entreprises">🏢 Entreprises</a>
        <a href="index.php?page=statistiques">📊 Statistiques</a>

        {% if session.user is defined %}
            {% if session.user.role == 'etudiant' %}
                <a href="index.php?page=wishlist">❤️ Ma Wish-list</a>
                <a href="index.php?page=mes-candidatures">📄 Mes candidatures</a>
            {% elseif session.user.role == 'recruteur' %}
                <a href="index.php?page=gestion-etudiants">🎓 Gestion des étudiants</a>
                <a href="index.php?page=candidatures-pilote">📁 Candidatures</a>
            {% elseif session.user.role == 'admin' %}
                <a href="index.php?page=gestion-pilotes">👨‍✈️ Gestion des pilotes</a>
                <a href="index.php?page=gestion-etudiants">🎓 Gestion des étudiants</a>
            {% endif %}
        {% endif %}
    </div>
    <a href="index.php?page=logout" class="btn-logout">🔴 Déconnexion</a>
</div>

<header class="entete">
    <div class="logo">
        <a href="index.php">
            <img src="/images/allostage.png" alt="Accueil AlloStage" class="logo-img">
        </a>
    </div>

    <nav class="navigation">
        <ul>
            <li><a href="index.php">Accueil</a></li>
            <li><a href="index.php?page=offres" class="actif">Offres de stages</a></li>
            <li><a href="index.php?page=entreprises">Entreprises</a></li>
            <li><a href="index.php?page=statistiques">Statistiques</a></li>

            {% if session.user is defined and session.user.role == 'etudiant' %}
                <li><a href="index.php?page=wishlist">Ma Wish-list</a></li>
                <li><a href="index.php?page=mes-candidatures">Mes candidatures</a></li>
            {% endif %}
        </ul>
    </nav>

    <div class="actions-entete">
        {% if session.user is defined %}
            <button id="open-menu" class="btn-principal">
                Espace {{ session.user.role_label ?? session.user.role|capitalize }} ▾
            </button>
        {% else %}
            <a href="index.php?page=connexion" class="btn-connexion">Se connecter</a>
        {% endif %}
    </div>
</header>

<main class="main">
    <div class="container">

        <a href="index.php?page=offre&id={{ offre.id_offre }}" class="back">← Retour à l'offre</a>

        {% if deja is defined and deja %}
            <div class="alerte alerte-info">
                Vous avez déjà postulé à cette offre.
                <a href="index.php?page=mes-candidatures">Voir mes candidatures →</a>
            </div>
        {% endif %}

        {% if erreurs is defined and erreurs %}
            <div class="alerte alerte-erreur">
                <strong>Le formulaire contient des erreurs :</strong>
                <ul>
                    {% for e in erreurs %}<li>{{ e }}</li>{% endfor %}
                </ul>
            </div>
        {% endif %}

        <div class="grid">

            <!-- FORMULAIRE -->
            <div class="content">
                <div class="card">

                    <h1>📨 Postuler à l'offre</h1>
                    <p class="subtitle">
                        <strong>{{ offre.titre }}</strong> — {{ offre.nom_entreprise }}
                    </p>

                    <form method="POST"
                          action="index.php?page=postuler&id={{ offre.id_offre }}"
                          enctype="multipart/form-data"
                          class="form-postuler">

                        <!-- CV -->
                        <div class="form-group">
                            <label for="cv">CV (PDF) <span class="req">*</span></label>
                            <input type="file" id="cv" name="cv" accept="application/pdf" required>
                            <small class="hint">Format PDF — taille max. 5 Mo</small>
                        </div>

                        <!-- LETTRE PDF -->
                        <div class="form-group">
                            <label for="lettre">Lettre de motivation (PDF)</label>
                            <input type="file" id="lettre" name="lettre" accept="application/pdf">
                            <small class="hint">Optionnel — vous pouvez aussi l'écrire ci-dessous</small>
                        </div>

                        <div class="separateur"><span>OU</span></div>

                        <!-- LETTRE TEXTE -->
                        <div class="form-group">
                            <label for="lettre_texte">Écrire votre lettre de motivation</label>
                            <textarea id="lettre_texte"
                                      name="lettre_texte"
                                      rows="8"
                                      placeholder="Bonjour, je me permets de vous adresser ma candidature pour le stage de...">{{ old.lettre_texte|default('') }}</textarea>
                            <small class="hint">Recommandé si vous n'avez pas de lettre en PDF</small>
                        </div>

                        <button type="submit" class="btn-primary">
                            🚀 Envoyer ma candidature
                        </button>
                    </form>
                </div>
            </div>

            <!-- SIDEBAR -->
            <div class="sidebar">
                <div class="card">
                    <h3>🎯 Rappel de l'offre</h3>
                    <p><strong>{{ offre.titre }}</strong></p>
                    <p>{{ offre.nom_entreprise }}</p>
                    <p>📍 {{ offre.ville }}</p>
                    <hr>
                    <p><strong>📅 Durée :</strong> {{ offre.duree_stage }} semaines</p>
                    <p><strong>💻 Compétence :</strong> {{ offre.competence }}</p>
                    <p><strong>💰 Salaire :</strong>
                        {% if offre.remuneration %}{{ offre.remuneration }} € / mois{% else %}Non précisé{% endif %}
                    </p>
                </div>

                <div class="card card-conseil">
                    <h3>💡 Conseils</h3>
                    <ul>
                        <li>Soyez clair et concis dans votre lettre</li>
                        <li>Adaptez votre CV à l'offre</li>
                        <li>Vérifiez l'orthographe avant d'envoyer</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</main>

<footer class="pied-de-page">
    <p>&copy; 2026 AlloStage. Tous droits réservés.</p>
    <p class="liens-footer">
        <a href="index.php?page=mentions">Mentions légales</a>
    </p>
</footer>

<script>
const openBtn  = document.getElementById('open-menu');
const closeBtn = document.getElementById('close-menu');
const menu     = document.getElementById('menu-burger');
const overlay  = document.getElementById('menu-overlay');

function openMenu()  { menu.classList.add('active');    overlay.classList.add('active'); }
function closeMenu() { menu.classList.remove('active'); overlay.classList.remove('active'); }

if (openBtn)  openBtn.addEventListener('click', openMenu);
if (closeBtn) closeBtn.addEventListener('click', closeMenu);
if (overlay)  overlay.addEventListener('click', closeMenu);
</script>

</body>
</html>
