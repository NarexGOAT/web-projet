# Sécurité : empêcher l'exécution de scripts dans uploads/lm
<FilesMatch "\.(php|phtml|pl|py|jsp|asp|sh|cgi)$">
    Require all denied
</FilesMatch>

# Forcer le bon type MIME pour les PDF
<FilesMatch "\.pdf$">
    Header set Content-Type "application/pdf"
    Header set X-Content-Type-Options "nosniff"
</FilesMatch>
